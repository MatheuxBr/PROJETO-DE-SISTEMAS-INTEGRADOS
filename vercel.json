
{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "api": {
        "root": "BACKEND/API",
        "framework": "express"
      },
      "frontend": {
        "root": "FRONTEND",
        "framework": "angular"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "api"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }
  